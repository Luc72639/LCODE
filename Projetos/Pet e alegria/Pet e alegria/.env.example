PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_e_alegria
DB_SSL=false
# DB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Em desenvolvimento o sistema funciona sem esta linha, mas em producao ela e obrigatoria.
SESSION_SECRET=troque-por-uma-chave-grande-e-aleatoria

# Se o banco estiver vazio, quatro animais de demonstracao sao criados automaticamente.
SEED_DEMO_DATA=true

# Se nao existir nenhum administrador, o sistema cria um automaticamente.
# Se ADMIN_BOOTSTRAP_PASSWORD ficar vazio, uma senha forte e aleatoria sera mostrada UMA VEZ no terminal.
ADMIN_BOOTSTRAP_NAME=Administrador Pet e Alegria
ADMIN_BOOTSTRAP_EMAIL=admin@petealegria.local
# ADMIN_BOOTSTRAP_PASSWORD=
